# Copia este archivo como .env (no se versiona) y completa los valores.
# Lo leen docker-compose.yml y la aplicación Spring Boot.

# Base de datos
CANCHAPP_DB_NOMBRE=canchapp
CANCHAPP_DB_USUARIO=canchapp
CANCHAPP_DB_CONTRASENA=cambia-esta-contrasena
CANCHAPP_DB_URL=jdbc:postgresql://localhost:5432/canchapp

# Clave para firmar el JWT: al menos 32 caracteres aleatorios.
CANCHAPP_JWT_SECRETO=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Orígenes del panel web permitidos por CORS, separados por coma
CANCHAPP_CORS_ORIGENES=http://localhost:4200
